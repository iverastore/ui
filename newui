RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt)
    local isOn = _bindActive("MacroBind")
    local macroType = Library.Flags["MacroType"] or "360 Macro"
    
    if macroType == "360 Macro" then
        -- Original 360 spin logic
        if isOn and not _spinWasOn and not spinBusy then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum then
                spinBusy = true
                spinActive = true
                spinStartTime = tick()
                local speed = Library.Flags["MacroSpeed"] or 100
                spinDuration = 4 / (speed / 10)
