local function CreateLibraryButton(parent, name, pos, size, callback)
    local Holder = Instance.new("Frame")
    Holder.Parent = parent
    Holder.Name = name
    Holder.Position = pos
    Holder.Size = size
    Holder.BackgroundTransparency = 1
    Holder.BorderSizePixel = 0

    local Outline = Instance.new("Frame")
    Outline.Parent = Holder
    Outline.Position = UDim2.new(0, 0, 0, 0)
    Outline.Size = UDim2.new(1, 0, 1, 0)
    Outline.BackgroundColor3 = Color3.fromRGB(1, 1, 1)
    Outline.BorderSizePixel = 0

    local Inline = Instance.new("Frame")
    Inline.Parent = Outline
    Inline.Position = UDim2.new(0, 1, 0, 1)
    Inline.Size = UDim2.new(1, -2, 1, -2)
    Inline.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    Inline.BorderSizePixel = 0

    local Indicator = Instance.new("TextButton")
    Indicator.Parent = Inline
    Indicator.Position = UDim2.new(0, 1, 0, 1)
    Indicator.Size = UDim2.new(1, -2, 1, -2)
    Indicator.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    Indicator.BorderSizePixel = 0
    Indicator.Text = ""
    Indicator.AutoButtonColor = false

    local Gradient = Instance.new("UIGradient")
    Gradient.Parent = Indicator
    Gradient.Rotation = 90
    Gradient.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(195, 195, 195))

    local Label = Instance.new("TextLabel")
    Label.Parent = Indicator
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(221, 221, 221)
    Label.FontFace = Library.Font
    Label.TextSize = 11
    Label.TextXAlignment = Enum.TextXAlignment.Center
    Label.TextYAlignment = Enum.TextYAlignment.Center

    Indicator.MouseEnter:Connect(function()
        TweenService:Create(Indicator, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 40)}):Play()
    end)
    Indicator.MouseLeave:Connect(function()
        TweenService:Create(Indicator, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 20, 20)}):Play()
    end)
    Indicator.MouseButton1Click:Connect(callback)

    return Holder
end

