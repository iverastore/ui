                lastSpinYaw = 0
                local dir = Library.Flags["MacroSpinDir"] or "Right"
                spinDirection = (dir == "Left") and -1 or 1
                prevAutoRotate = hum.AutoRotate
                local target = Library.Flags["MacroSpinTarget"] or "Both"
                if target == "Character" or target == "Both" then
                    hum.AutoRotate = false
                end
            end
        end
        _spinWasOn = isOn
        if spinActive then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local Alpha = math.clamp((tick() - spinStartTime) / spinDuration, 0, 1)
            currentSpinYaw = 360 * spinDirection * Alpha
            local target = Library.Flags["MacroSpinTarget"] or "Both"
            if (target == "Character" or target == "Both") and hrp and hrp.Parent then
                local currentPos = hrp.Position
                hrp.CFrame = CFrame.new(currentPos) * CFrame.Angles(0, math.rad(currentSpinYaw), 0)
            end
            if (target == "Camera" or target == "Both") then
                if not _aimbotSetCamera then
                    local deltaAngle = currentSpinYaw - lastSpinYaw
                    Camera.CFrame = Camera.CFrame * CFrame.Angles(0, math.rad(deltaAngle), 0)
                end
            end
            lastSpinYaw = currentSpinYaw
            if Alpha >= 1 or not hrp or not hrp.Parent or not hum or not hum.Parent then
                spinActive = false
                spinBusy = false
                currentSpinYaw = 0
                lastSpinYaw = 0
                if hum and hum.Parent and prevAutoRotate ~= nil then
                    hum.AutoRotate = prevAutoRotate
                    prevAutoRotate = nil
                end
            end
        end
    elseif macroType == "Flick Off" then
        -- Flick: instant offset, stay for duration, return based on mode
        if isOn and not _spinWasOn then
            local flickDir = Library.Flags["MacroFlickDir"] or "Right"
            local flickDistance = Library.Flags["MacroFlickDistance"] or 150
            local flickDuration = (Library.Flags["MacroFlickDuration"] or 300) / 1000
            local flickReturn = Library.Flags["MacroFlickReturn"] or "Instant"
            local flickRandom = (Library.Flags["MacroFlickRandom"] or 0) / 100
            local flickAngle = math.rad(Library.Flags["MacroFlickAngle"] or 0)

            local dx, dy = 0, 0
            if flickDir == "Right" then dx = flickDistance
            elseif flickDir == "Left" then dx = -flickDistance
            elseif flickDir == "Up" then dy = -flickDistance
            elseif flickDir == "Down" then dy = flickDistance
            elseif flickDir == "Random" then
                local ang = math.random() * math.pi * 2
                dx = math.cos(ang) * flickDistance
                dy = math.sin(ang) * flickDistance
            elseif flickDir == "Custom" then
                dx = math.cos(flickAngle) * flickDistance
                dy = math.sin(flickAngle) * flickDistance
            end

            if flickRandom > 0 then
                dx = dx + (math.random() - 0.5) * flickDistance * flickRandom * 2
                dy = dy + (math.random() - 0.5) * flickDistance * flickRandom * 2
            end

            -- Instant flick to offset position
            pcall(function() mousemoverel(dx, dy) end)

            -- Stay at offset for duration
            task.wait(flickDuration)

            -- Return based on selected mode
            if flickReturn == "Instant" then
                pcall(function() mousemoverel(-dx, -dy) end)
            elseif flickReturn == "Smooth" then
                local steps = math.max(5, math.floor(flickDuration * 60))
                for i = 1, steps do
                    pcall(function() mousemoverel(-dx / steps, -dy / steps) end)
                    task.wait(flickDuration / steps)
                end
            elseif flickReturn == "Bounce" then
                local overshoot = 0.3
                pcall(function() mousemoverel(-dx * (1 + overshoot), -dy * (1 + overshoot)) end)
                task.wait(flickDuration * 0.4)
                pcall(function() mousemoverel(dx * overshoot, dy * overshoot) end)
            end
        end
        _spinWasOn = isOn
    elseif macroType == "Shaky" then
        -- Shaky: continuous shake with X/Y straight line movement
        if isOn then
            local speed = (Library.Flags["MacroSpeed"] or 65) / 100
            local strength = (Library.Flags["MacroStrength"] or 70) / 100
            local shakeType = Library.Flags["MacroShakeType"] or "Random"
            local shakePos = Library.Flags["MacroShakePos"] or "Everywhere"
            local shakeAmount = (Library.Flags["MacroShakeAmount"] or 40) / 10
            local randomization = (Library.Flags["MacroRandomization"] or 50) / 100
            local delay = (Library.Flags["MacroDelay"] or 6) / 1000
            local smoothness = (Library.Flags["MacroSmoothness"] or 50) / 100

            local t = tick() * speed * 10
            
            local shakeX, shakeY = 0, 0
            if shakeType == "Circular" then
                shakeX = math.cos(t) * shakeAmount * strength
                shakeY = math.sin(t) * shakeAmount * strength
            elseif shakeType == "Random" then
                shakeX = (math.random() - 0.5) * 2 * shakeAmount * strength * randomization
                shakeY = (math.random() - 0.5) * 2 * shakeAmount * strength * randomization
                -- Add straight line X/Y movement
                _macroStraightDir = _macroStraightDir * -1
                shakeX = shakeX + (_macroStraightDir * shakeAmount * strength * 0.5)
                shakeY = shakeY + (_macroStraightDir * shakeAmount * strength * 0.5)
            end
            
            -- Apply shake pos offset
            if shakePos == "Center" then
                _macroShakeOffset = Vector2.new(shakeX * 0.5, shakeY * 0.5)
            elseif shakePos == "Everywhere" then
                _macroShakeOffset = Vector2.new(shakeX, shakeY)
            else
                _macroShakeOffset = Vector2.new(0, 0)
            end
            
            -- Use mousemoverel with full strength (no 0.1 reduction)
            local smoothFactor = 1 - (smoothness * 0.5)
            local moveX = _macroShakeOffset.X * smoothFactor
            local moveY = _macroShakeOffset.Y * smoothFactor
            if moveX ~= 0 or moveY ~= 0 then
                pcall(function() mousemoverel(moveX, moveY) end)
            end
            
            task.wait(delay)
        else
            _macroShakeOffset = Vector2.new(0, 0)
        end
        _spinWasOn = isOn
    end
end))

