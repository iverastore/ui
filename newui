    local showSelf = Library.Flags["ChamsShowSelf"]
    local showOthers = Library.Flags["ChamsShowOthers"]
    local showNPCs = Library.Flags["ChamsShowNPCs"]
    local checks = Library.Flags["ChamsChecks"] or {}
    if type(checks) ~= "table" then checks = {} end
    local checkWall = hasCheck(checks, "Wall")
    local checkDead = hasCheck(checks, "Dead")
    local material = Library.Flags["ChamsMaterial"] or "Default"
    local glow = Library.Flags["ChamsGlow"]
    local fillTrans = (Library.Flags["ChamsFillTransparency"] or 50) / 100
    local outlineTrans = (Library.Flags["ChamsOutlineTransparency"] or 0) / 100
    if glow then fillTrans = math.min(fillTrans, 0.05) end

    local function getColors()
        local baseFill = Color3.fromRGB(255, 0, 0)
        if Library.Flags["ChamsFillColor"] then
            if typeof(Library.Flags["ChamsFillColor"]) == "Color3" then
                baseFill = Library.Flags["ChamsFillColor"]
            elseif type(Library.Flags["ChamsFillColor"]) == "table" and Library.Flags["ChamsFillColor"].Color then
                baseFill = Library.Flags["ChamsFillColor"].Color
            end
        end
        local baseOutline = Color3.fromRGB(255, 255, 255)
        if Library.Flags["ChamsOutlineColor"] then
            if typeof(Library.Flags["ChamsOutlineColor"]) == "Color3" then
                baseOutline = Library.Flags["ChamsOutlineColor"]
            elseif type(Library.Flags["ChamsOutlineColor"]) == "table" and Library.Flags["ChamsOutlineColor"].Color then
                baseOutline = Library.Flags["ChamsOutlineColor"].Color
            end
        end
        local mode = Library.Flags["ChamsRGBMode"] or "Static"
        local speed = Library.Flags["ChamsRGBSpeed"] or 30
        return getRGBColor(baseFill, mode, speed), getRGBColor(baseOutline, mode, speed)
    end

    local function applyHighlight(char)
        if not char then return end
        local hl = char:FindFirstChild("_Chams")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "_Chams"
            -- DepthMode = AlwaysOnTop renders through walls (wall-hack style chams)
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        end
        local fillColor, outlineColor = getColors()
        hl.FillColor = fillColor
        hl.OutlineColor = outlineColor
        hl.FillTransparency = fillTrans
        hl.OutlineTransparency = outlineTrans
        -- Adornee must be the character Model for Highlight to render
        hl.Adornee = char
        if hl.Parent ~= char then
            hl.Parent = char
        end
        applyChamsMaterial(char, material)
    end

    local function removeHighlight(char)
        if not char then return end
        local hl = char:FindFirstChild("_Chams")
        if hl then hl:Destroy() end
        revertMaterialChams(char)
    end

    if not enabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then removeHighlight(p.Character) end
        end
        for _, bot in ipairs(getNPCs()) do
            removeHighlight(bot)
        end
        return
    end

    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if char then
            local isSelf = (p == LocalPlayer)
            local shouldCham = isSelf and showSelf or (not isSelf and showOthers)
            if shouldCham then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local isDead = hum and (hum.Health <= 0 or isKnockedOrKO(char) or isDeadCheck(char))
                if checkDead and isDead then
                    removeHighlight(char)
                elseif checkWall and not isSelf then
                    local visible = false
                    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
                    if hrp then
                        local origin = Camera.CFrame.Position
                        local rayParams = RaycastParams.new()
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        rayParams.FilterDescendantsInstances = {LocalPlayer.Character, char}
                        local res = Workspace:Raycast(origin, hrp.Position - origin, rayParams)
                        if not res then
                            visible = true
                        end
                    end
                    if visible then
                        applyHighlight(char)
                    else
                        removeHighlight(char)
                    end
                else
                    applyHighlight(char)
                end
            else
                removeHighlight(char)
            end
        end
    end

    if showNPCs then
        for _, bot in ipairs(getNPCs()) do
            local hum = bot:FindFirstChildOfClass("Humanoid")
            local isDead = hum and (hum.Health <= 0 or isKnockedOrKO(bot) or isDeadCheck(bot))
            if checkDead and isDead then
                removeHighlight(bot)
            elseif checkWall then
                local visible = false
                local hrp = bot:FindFirstChild("HumanoidRootPart") or bot:FindFirstChild("Head")
                if hrp then
                    local origin = Camera.CFrame.Position
                    local rayParams = RaycastParams.new()
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, bot}
                    local res = Workspace:Raycast(origin, hrp.Position - origin, rayParams)
                    if not res then
                        visible = true
                    end
                end
                if visible then
                    applyHighlight(bot)
                else
                    removeHighlight(bot)
                end
            else
                applyHighlight(bot)
            end
        end
    else
        for _, bot in ipairs(getNPCs()) do
            removeHighlight(bot)
        end
    end
end)

