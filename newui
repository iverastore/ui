    if t < 1 / d1 then
        r = n1 * t * t
    elseif t < 2 / d1 then
        local tt = t - 1.5 / d1
        r = n1 * tt * tt + 0.75
    elseif t < 2.5 / d1 then
        local tt = t - 2.25 / d1
        r = n1 * tt * tt + 0.9375
    else
        local tt = t - 2.625 / d1
        r = n1 * tt * tt + 0.984375
    end
    return b * r + (1 - b) * t
