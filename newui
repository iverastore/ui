local function getRGBColor(baseColor, mode, speed)
    local t = tick() * (speed or 30) / 10
    if mode == "Rainbow" then
        return Color3.fromHSV((t % 360) / 360, 1, 1)
    elseif mode == "Breathing" then
        local s = (math.sin(t) + 1) / 2
        return baseColor:Lerp(Color3.new(1, 1, 1), s * 0.3)
    elseif mode == "Pulse" then
        local s = (math.sin(t * 2) + 1) / 2
        return baseColor:Lerp(Color3.new(0, 0, 0), s * 0.5)
    elseif mode == "RGB Fade" then
        local r = (math.sin(t) + 1) / 2
        local g = (math.sin(t + 2.09) + 1) / 2
        local b = (math.sin(t + 4.18) + 1) / 2
        return Color3.new(r, g, b)
    end
    return baseColor
end

local function applyChamsMaterial(char, material)
    if not char then return end
    if material == "Default" or not material then
        revertMaterialChams(char)
    else
