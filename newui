local function updateEasingVis()
    local useEasing = not not Library.Flags["UseEasing"]
    local style = Library.Flags["EaseStyle"] or "Quad"
    
    -- Always show these when UseEasing is ON
    if Library.visible_flags["EaseStyle"] then Library.visible_flags["EaseStyle"](useEasing) end
    if Library.visible_flags["EaseDir"] then Library.visible_flags["EaseDir"](useEasing) end
    if Library.visible_flags["EaseSpeed"] then Library.visible_flags["EaseSpeed"](useEasing) end
    
    -- Show style-specific sliders ONLY when relevant
    if Library.visible_flags["Elasticity"] then Library.visible_flags["Elasticity"](useEasing and style == "Elastic") end
    if Library.visible_flags["EaseExponent"] then Library.visible_flags["EaseExponent"](useEasing and (style == "Cubic" or style == "Quart" or style == "Quint")) end
    if Library.visible_flags["BounceBounciness"] then Library.visible_flags["BounceBounciness"](useEasing and style == "Bounce") end
    if Library.visible_flags["BackOvershoot"] then Library.visible_flags["BackOvershoot"](useEasing and style == "Back") end
    if Library.visible_flags["ElasticPeriod"] then Library.visible_flags["ElasticPeriod"](useEasing and style == "Elastic") end
    if Library.visible_flags["SharpPower"] then Library.visible_flags["SharpPower"](useEasing and style == "Sharp") end
    
    -- Adaptive options
    local isAdaptive = style == "Adaptive" or style == "Zigzag" or style == "Pulse"
    if Library.visible_flags["AdaptSwaySpeed"] then Library.visible_flags["AdaptSwaySpeed"](useEasing and isAdaptive) end
    if Library.visible_flags["AdaptSwayWidth"] then Library.visible_flags["AdaptSwayWidth"](useEasing and isAdaptive) end
    if Library.visible_flags["AdaptJitterAmt"] then Library.visible_flags["AdaptJitterAmt"](useEasing and style == "Adaptive") end
