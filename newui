        if not target then
            aimbotTarget = nil
            _lastAimbotTargetPos = nil
            _lastAimbotTargetPlayer = nil
            _smoothedAimPos = nil
            _mouseRemainderX = 0
            _mouseRemainderY = 0
            _aimVelPitch = 0
            _aimVelYaw = 0
            return
        end
        if Library.Flags["DelayJump"] then
            local targetChar = target.Parent
            if targetChar then
                local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
                if targetHum then
                    local state = targetHum:GetState()
                    local vel = target.AssemblyLinearVelocity or target.Velocity or Vector3.new(0,0,0)
                    local isInAir = (targetHum.FloorMaterial == Enum.Material.Air) or (state == Enum.HumanoidStateType.Freefall) or (state == Enum.HumanoidStateType.Jumping) or (math.abs(vel.Y) > 0.5)
                    if isInAir and not _lastTargetInAir then
                        _delayJumpCount = _delayJumpCount + 1
                        _delayJumpTimer = tick()
                    end
                    _lastTargetInAir = isInAir
                    if isInAir and _delayJumpCount <= (Library.Flags["DelayForXJumps"] or 1) then
                        local elapsed = (tick() - _delayJumpTimer) * 1000
                        if elapsed < (Library.Flags["DelayJumpMs"] or 100) then
                            return
                        end
                    end
                    if not isInAir then
                        _delayJumpCount = 0
                    end
                end
            end
        end
        local plr = Players:GetPlayerFromCharacter(target.Parent)
        if plr then aimbotTarget = plr else aimbotTarget = nil end
        local resolvedPart, resolvedHitPart = getTargetPart(target.Parent)
        if resolvedPart then
            target = resolvedPart
        end
        local targetPos = target.Position
        
        local targetHRP = target.Parent:FindFirstChild("HumanoidRootPart")
        if targetHRP then
            local targetKey = target.Parent:GetDebugId()
            local relOffset = targetHRP.CFrame:PointToObjectSpace(target.Position)
            
            if _lastPartSwitchTarget ~= targetKey then
                _currentPartOffset = relOffset
                _lastPartSwitchTarget = targetKey
            end
            
            if Library.Flags["UsePartSwitchSpeed"] then
                local hum = target.Parent:FindFirstChildOfClass("Humanoid")
                local switchSpeed = 15
                if hum then
                    local state = hum:GetState()
                    local vel = targetHRP.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
                    local isJumping = (state == Enum.HumanoidStateType.Jumping) or (vel.Y > 1)
                    local isFalling = (state == Enum.HumanoidStateType.Freefall) or (vel.Y < -1)
                    if isJumping then
                        switchSpeed = Library.Flags["SwitchSpeedJump"] or 15
                    elseif isFalling then
                        switchSpeed = Library.Flags["SwitchSpeedFall"] or 15
                    else
                        switchSpeed = Library.Flags["SwitchSpeedGround"] or 15
                    end
                end
                
                local speed = (switchSpeed ^ 2) * 0.02
                local alpha = math.clamp(1 - math.exp(-speed * dt), 0.001, 1)
                _currentPartOffset = _currentPartOffset:Lerp(relOffset, alpha)
                targetPos = targetHRP.CFrame:PointToWorldSpace(_currentPartOffset)
            else
                _currentPartOffset = relOffset
            end
        end
        if Library.Flags["UsePred"] then
            targetPos = getPredictedPosition(target, false, targetPos)
        end
        if resolvedHitPart == "Neck" and target.Name == "Head" then
            targetPos = targetPos - Vector3.new(0, 0.45, 0)
        end
        if Library.Flags["UseOffsets"] then
            local camCF = Camera.CFrame
            local upOffset = (Library.Flags["OffsetUp"] or 0) / 10
            local downOffset = (Library.Flags["OffsetDown"] or 0) / 10
            local leftOffset = (Library.Flags["OffsetLeft"] or 0) / 10
            local rightOffset = (Library.Flags["OffsetRight"] or 0) / 10
            local totalOffset = camCF.UpVector * (upOffset - downOffset) + camCF.RightVector * (rightOffset - leftOffset)
            targetPos = targetPos + totalOffset
        end
        if Library.Flags["UseOffsets"] and Library.Flags["UseAirOffset"] then
            local targetOffset = 0
            local targetChar3 = target.Parent
            local targetHum3 = targetChar3 and targetChar3:FindFirstChildOfClass("Humanoid")
            local isInAir = false
            if targetHum3 then
                local state = targetHum3:GetState()
                local hrp3 = targetChar3 and targetChar3:FindFirstChild("HumanoidRootPart")
                local vel = hrp3 and (hrp3.AssemblyLinearVelocity or hrp3.Velocity) or Vector3.new(0, 0, 0)
                isInAir = (state == Enum.HumanoidStateType.Jumping) or (state == Enum.HumanoidStateType.Freefall) or (math.abs(vel.Y) > 0.5)
            end
            if isInAir then
                targetOffset = (Library.Flags["AirOffsetVal"] or 0) / 10
            end
            local smoothVal = 10
            if Library.Flags["AirOffsetUseAimbotSmooth"] then
                smoothVal = Library.Flags["UseSmoothingPlus"] and (Library.Flags["SmoothY"] or 10) or (Library.Flags["SmoothAmt"] or 10)
            else
                smoothVal = Library.Flags["AirOffsetSmooth"] or 15
            end
            local speed = 7000 / (smoothVal * smoothVal + 0.1)
            local alpha = 1 - math.exp(-speed * dt)
            _currentAirOffset = _currentAirOffset + (targetOffset - _currentAirOffset) * math.clamp(alpha, 0.001, 1)
            targetPos = targetPos + Vector3.new(0, _currentAirOffset, 0)
        else
            _currentAirOffset = 0
        end

        _smoothedAimPos = targetPos
        targetPos = _smoothedAimPos

        local targetPlr = Players:GetPlayerFromCharacter(target.Parent)
        _lastAimbotTargetPlayer = targetPlr
        _lastAimbotTargetPos = targetPos
        
        local smoothX = Library.Flags["SmoothX"] or 1
        local smoothY = Library.Flags["SmoothY"] or 1
        if not Library.Flags["UseSmoothingPlus"] then
            local amt = Library.Flags["SmoothAmt"] or 1
            smoothX = amt
            smoothY = amt
        end
        smoothX = math.max(smoothX, 0.01)
        smoothY = math.max(smoothY, 0.01)
        local aimPos = targetPos

        local lockMethod = Library.Flags["LockMethod"] or "Camera"
        if lockMethod == "Mouse" then
            local targetScreenPos, onScreen = Camera:WorldToViewportPoint(aimPos)
            if onScreen then
                local mousePos = UserInputService:GetMouseLocation()
                local rxRel = targetScreenPos.X - mousePos.X
                local ryRel = targetScreenPos.Y - mousePos.Y

                if not Library.Flags["UseSmoothing"] then
                    local dx = math.round(rxRel)
                    local dy = math.round(ryRel)
                    if dx ~= 0 or dy ~= 0 then
                        pcall(function() mousemoverel(dx, dy) end)
                    end
                else
                    local sx = math.max(smoothX, 1)
                    local sy = math.max(smoothY, 1)
                    
                    local sens = 1
                    pcall(function() sens = UserSettings():GetService("UserGameSettings").MouseSensitivity end)
                    if sens <= 0.01 then sens = 1 end

                    local moveX = (rxRel / sx) / sens
                    local moveY = (ryRel / sy) / sens
                    
                    if Library.Flags["UseEasing"] then
                        local easeSpeed = (Library.Flags["EaseSpeed"] or 70) / 70
                        moveX = moveX * easeSpeed
                        moveY = moveY * easeSpeed
                    end

                    _mouseRemainderX = _mouseRemainderX + moveX
                    _mouseRemainderY = _mouseRemainderY + moveY

                    local intX = math.round(_mouseRemainderX)
                    local intY = math.round(_mouseRemainderY)

                    _mouseRemainderX = _mouseRemainderX - intX
                    _mouseRemainderY = _mouseRemainderY - intY

                    if intX ~= 0 or intY ~= 0 then
                        pcall(function() mousemoverel(intX, intY) end)
                    end
                end
            end
        else
            local camCF = Camera.CFrame
            local isSpinning = spinActive and (Library.Flags["MacroSpinTarget"] == "Camera" or Library.Flags["MacroSpinTarget"] == "Both")
            if isSpinning then
                camCF = camCF * CFrame.Angles(0, math.rad(-_aimbotAppliedSpin), 0)
            end
            local targetCF = CFrame.lookAt(camCF.Position, aimPos)

            _aimbotSetCamera = true
            local finalCF = targetCF
            if Library.Flags["UseSmoothing"] then
                local easeSpeed = (Library.Flags["EaseSpeed"] or 70) / 70
                local alpha = 1 - math.exp(-(6 / smoothX) * easeSpeed * 120 * dt)
                if Library.Flags["UseEasing"] then alpha = applyEasing(alpha) end
                finalCF = camCF:Lerp(targetCF, math.clamp(alpha, 0.001, 1))
            end

            if isSpinning then
                finalCF = finalCF * CFrame.Angles(0, math.rad(currentSpinYaw), 0)
                _aimbotAppliedSpin = currentSpinYaw
            else
                _aimbotAppliedSpin = 0
            end

            Camera.CFrame = finalCF
        end
    end))
end)
