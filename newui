-- ==================== WORLD HEARTBEAT LOOP (Skybox Spin, Atmosphere, Lighting, Trigger Bot) ====================
_lastDensity, _lastOffset, _lastGlare, _lastHaze = nil, nil, nil, nil
_lastFogColor, _lastFogStart, _lastFogEnd = nil, nil, nil
_fogSpinAngle = 0
RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt)
    if Library.Flags["CustomFog"] then
        local color = getColor("c_fog", Color3.fromRGB(128,128,128))
        local startV = Library.Flags["FogStart"] or 0
        local endV = Library.Flags["FogEnd"] or 5000
        if Library.Flags["FogSpin"] then
            local spd = (Library.Flags["FogSpinSpd"] or 20)
            _fogSpinAngle = (_fogSpinAngle + spd * dt) % 360
            local hue = _fogSpinAngle / 360
            color = Color3.fromHSV(hue, 0.8, 1)
            local pulse = math.sin(math.rad(_fogSpinAngle * 2))
            endV = (Library.Flags["FogEnd"] or 5000) + pulse * ((Library.Flags["FogEnd"] or 5000) * 0.15)
        end
        if color ~= _lastFogColor or startV ~= _lastFogStart or endV ~= _lastFogEnd then
            _lastFogColor, _lastFogStart, _lastFogEnd = color, startV, endV
            pcall(function()
                Lighting.FogColor = color
                Lighting.FogStart = startV
                Lighting.FogEnd = endV
            end)
        end
    end
    if Library.Flags["SkySpin"] and Library.Flags["CustomSkybox"] and skyboxObj then
        local spd = (Library.Flags["SkySpinSpd"] or 20)
        pcall(function()
            skyboxObj.SkyboxOrientation = skyboxObj.SkyboxOrientation + Vector3.new(0, spd * dt, 0)
        end)
    end
    if Library.Flags["OverAtmo"] then
        local a = getOrCreateAtmo()
        local density = (Library.Flags["AtmoD"] or 40)/200
        local offset = (Library.Flags["AtmoO"] or 0)/100
        local glare = (Library.Flags["AtmoG"] or 0)/25
        local haze = (Library.Flags["AtmoH"] or 0)/10
        if density ~= _lastDensity or offset ~= _lastOffset or glare ~= _lastGlare or haze ~= _lastHaze then
            _lastDensity, _lastOffset, _lastGlare, _lastHaze = density, offset, glare, haze
            pcall(function()
                a.Density = density
                a.Offset = offset
                a.Glare = glare
                a.Haze = haze
            end)
        end
    end
    if Library.Flags["OverLight"] then
        local bright = Library.Flags["Bright"] or 1
        pcall(function()
            if Lighting.Brightness ~= bright then Lighting.Brightness = bright end
            local boost = math.clamp((bright - 1) * 0.15, -0.3, 0.3)
            local targetAmbient = Color3.new(0.5 + boost, 0.5 + boost, 0.5 + boost)
            if Lighting.OutdoorAmbient ~= targetAmbient then Lighting.OutdoorAmbient = targetAmbient end
        end)
        local sat = (Library.Flags["Sat"] or 0) / 100
        local cont = (Library.Flags["Cont"] or 0) / 100
        pcall(function()
            local cc = getOrCreateCC()
            if cc.Saturation ~= sat then cc.Saturation = sat end
            if cc.Contrast ~= cont then cc.Contrast = cont end
        end)
    end
    if _bindActive("TriggerBotBind") then
        local tbDelay = (Library.Flags["TriggerBotDelay"] or 0) / 1000
        local reqTarget = Library.Flags["TriggerBotRequireTarget"]
        if reqTarget == nil then reqTarget = true end
        local canTrigger = false
        if reqTarget then
            if currentTarget then canTrigger = true end
        else
            canTrigger = true
        end
        if canTrigger then
            _G.lastTriggerClick = _G.lastTriggerClick or 0
            if tick() - _G.lastTriggerClick >= tbDelay then
                local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                    _G.lastTriggerClick = tick()
                end
            end
        end
    end
end))

