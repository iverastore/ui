-- ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ RAIN (3D Streak Volume) ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬

local _rainStreaks = {}
local _rainVolFolder = nil

local function _stopRain()
    if _rainFollowConn then _rainFollowConn:Disconnect(); _rainFollowConn = nil end
    if _splashConn then _splashConn:Disconnect(); _splashConn = nil end
    for _, e in ipairs(rainEmitters) do pcall(function() e:Destroy() end) end
    rainEmitters = {}
    destroyRainPart()
    for _, s in ipairs(_rainStreaks) do pcall(function() s.part:Destroy() end) end
    table.clear(_rainStreaks)
    if _rainVolFolder then pcall(function() _rainVolFolder:Destroy() end); _rainVolFolder = nil end
    if _splashFolder then pcall(function() _splashFolder:Destroy() end); _splashFolder = nil end
end

local function _enableRain()
    local cam = Workspace.CurrentCamera
    _stopRain()
    local rate = rainSettings.Rate or 300
    local spd = rainSettings.Speed or 120
    local sz = rainSettings.Size or 8
    local radius = rainSettings.Radius or 100
    local widthPct = (rainSettings.Width or 30) / 100

    -- Volume dimensions around the Camera (radius now fully respected)
    local halfX = radius
    local halfZ = radius
    local topY = 45      -- spawn height above Camera
    local botY = -25     -- recycle below Camera
    local span = topY - botY

    local streakLen = sz * 0.9                 -- length of each streak (studs)
    local streakWid = streakLen * widthPct     -- width as a % of length, so texture is visible
    local count = math.clamp(math.floor(rate), 10, 600)

    _rainVolFolder = Instance.new("Folder")
    _rainVolFolder.Name = "_RainVolume"
    _rainVolFolder.Parent = Workspace

    local baseColor = Library.Flags["c_rain"] and getCol3(Library.Flags["c_rain"]) or Color3.fromRGB(190, 205, 240)
    local camPos = cam.CFrame.Position

    for i = 1, count do
        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.CastShadow = false
        part.Transparency = 1
        part.Size = Vector3.new(0.2, 0.2, 0.2)
        part.Parent = _rainVolFolder

        -- depth-based size variation: some streaks larger (close), some smaller (far)
        local depthScale = 0.45 + math.random() * 1.3

        local bb = Instance.new("BillboardGui")
        bb.Adornee = part
        bb.AlwaysOnTop = false
        bb.LightInfluence = 0
        bb.Size = UDim2.fromScale(streakWid * depthScale, streakLen * depthScale)
        bb.Parent = part

        local img = Instance.new("ImageLabel")
        img.BackgroundTransparency = 1
        img.Size = UDim2.fromScale(1, 1)
        img.Image = RAIN_TEX
        img.ImageColor3 = baseColor
        img.ImageTransparency = 0.25 + math.random() * 0.25
        img.Parent = bb

        local ox = (math.random() * 2 - 1) * halfX
        local oz = (math.random() * 2 - 1) * halfZ
        local oy = botY + math.random() * span
        part.CFrame = CFrame.new(camPos + Vector3.new(ox, oy, oz))

        table.insert(_rainStreaks, {
            part = part,
            ox = ox,
            oz = oz,
            y = oy,
            speed = spd * (0.8 + depthScale * 0.4),
        })
    end

    -- Splash folder
    _splashFolder = Instance.new("Folder")
    _splashFolder.Name = "_RainSplashes"
    _splashFolder.Parent = Workspace

    -- Move streaks each frame; keep volume centered on Camera
    _rainFollowConn = RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt)
        if not rainRunning then return end
        local cpos = Workspace.CurrentCamera.CFrame.Position
        for _, s in ipairs(_rainStreaks) do
            if not s.part.Parent then continue end
            s.y = s.y - s.speed * dt
            if s.y <= botY then
                s.y = topY
                s.ox = (math.random() * 2 - 1) * halfX
                s.oz = (math.random() * 2 - 1) * halfZ
            end
            s.part.CFrame = CFrame.new(cpos.X + s.ox, cpos.Y + s.y, cpos.Z + s.oz)
        end
    end))

    -- Splash spawning ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â raycast down from random points around player (optional)
    local splashTimer = 0
    if rainSettings.Splashes ~= false then
    _splashConn = RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function(dt)
        if not rainRunning then return end
        splashTimer = splashTimer + dt
        if splashTimer < 0.05 then return end
        splashTimer = 0
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local hrpPos = hrp.Position
        local splashCount = math.clamp(math.floor(rate / 60), 1, 6)

        for i = 1, splashCount do
            local angle = math.random() * math.pi * 2
            local dist = math.random() * math.min(radius, 50)
            local origin = hrpPos + Vector3.new(math.cos(angle) * dist, 30, math.sin(angle) * dist)
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {char, _splashFolder, _rainVolFolder}
            local result = Workspace:Raycast(origin, Vector3.new(0, -50, 0), rayParams)
            if result and result.Position then
                local splashSz = sz * 0.5
                local splashPart = Instance.new("Part")
                splashPart.Anchored = true
                splashPart.CanCollide = false
                splashPart.CanQuery = false
                splashPart.CastShadow = false
                splashPart.Transparency = 1
                splashPart.Size = Vector3.new(splashSz, 0.05, splashSz)
                -- Upright splash, not rotated to surface
                splashPart.CFrame = CFrame.new(result.Position + Vector3.new(0, 0.05, 0))
                splashPart.Parent = _splashFolder

                local decal = Instance.new("Decal")
                decal.Texture = SPLASH_TEX
                decal.Color3 = baseColor
                decal.Face = Enum.NormalId.Top
                decal.Transparency = 0.2
                decal.Parent = splashPart

                -- Quick scale-up + fade
                task.spawn(function()
                    local t = 0
                    while t < 0.45 and splashPart.Parent and rainRunning do
                        t = t + RunService.Heartbeat:Wait()
                        local a = math.min(t / 0.45, 1)
                        local s = splashSz * (0.6 + a * 0.7)
                        splashPart.Size = Vector3.new(s, 0.05, s)
                        decal.Transparency = 0.2 + a * 0.8
                    end
                    if splashPart.Parent then splashPart:Destroy() end
                end)
            end
        end
    end))
    end
end

_W.enableRain = function()
    if rainRunning then return end; rainRunning = true
    _enableRain()
end
_W.disableRain = function()
    rainRunning = false
    _stopRain()
end
_W.refreshRain = function()
    if rainRunning then _stopRain(); _enableRain() end
end

