            if typeof(Library.Flags["ChamsFillColor"]) == "Color3" then
                color = Library.Flags["ChamsFillColor"]
            elseif type(Library.Flags["ChamsFillColor"]) == "table" and Library.Flags["ChamsFillColor"].Color then
                color = Library.Flags["ChamsFillColor"].Color
            end
        end
        applyMaterialChams(char, material, color)
    end
end

local updateChams = LPH_NO_VIRTUALIZE(function()
