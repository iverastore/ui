    -- ── Helpers ───────────────────────────────────────────────────────────
    local function GetToolName(player)
        if player and player.Character then
            local tool = player.Character:FindFirstChildOfClass("Tool")
            if tool then return tool.Name end
        end
        return "None"
    end

    local toolModel
    local rotation = 0

    local function ClearGunViewport()
        if toolModel then
            toolModel:Destroy()
            toolModel = nil
        end
        CachedTool = nil
    end

    local function UpdateGunViewport(player)
        if not player or not player.Character then ClearGunViewport(); GunViewport.Visible = false; return end
        local tool = player.Character:FindFirstChildOfClass("Tool")
        if not tool then ClearGunViewport(); GunViewport.Visible = false; return end
        if CachedTool == tool then return end
        ClearGunViewport()
        CachedTool = tool

        toolModel = tool:Clone()
        toolModel.Parent = GunViewport
        for _, obj in ipairs(toolModel:GetDescendants()) do
            if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                obj:Destroy()
            end
        end

        local handle = toolModel:FindFirstChild("Handle")
        if not handle then
            for _, part in ipairs(toolModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    handle = part
                    break
                end
            end
        end
        if not handle then return end
        toolModel.PrimaryPart = handle
        toolModel:PivotTo(CFrame.new(0, 0, 0))

        local size = toolModel:GetExtentsSize()
        local biggest = math.max(size.X, size.Y, size.Z)
        ViewportCam.CFrame = CFrame.new(Vector3.new(0, 0, biggest * 3.5), Vector3.new(0, 0, 0))
    end

    -- Slow rotation loop for gun preview inside Target HUD
    local rotationConn
    rotationConn = RunService.RenderStepped:Connect(function(dt)
        if not Root.Visible then return end
        if toolModel and toolModel.PrimaryPart then
            rotation = (rotation + dt * 25) % 360
            toolModel:PivotTo(
                CFrame.new(0, 0, 0) *
                CFrame.Angles(math.rad(15), math.rad(rotation), 0)
            )
        end
    end)

    -- ── Update loop ───────────────────────────────────────────────────────
    local _lastAvatarId = nil
    local function Update()
        local autoTarget = getgenv()._iveraCurrent_AimbotTarget
        local target = autoTarget or CurrentTarget or SelectedPlayer
        local enabled = Library.Flags["TargetHUD"] == true
        if not enabled or not target then
            Root.Visible = false
            return
        end
        Root.Visible = true

        local scale = math.clamp((Library.Flags["TargetHUDScale"] or 100) / 100, 0.5, 2)
        Root.Size = UDim2.fromOffset(math.floor(260 * scale), math.floor(130 * scale))

        local showAvatar  = Library.Flags["TargetHUDAvatar"]   ~= false
        local showHealth  = Library.Flags["TargetHUDHealth"]   ~= false
        local showDist    = Library.Flags["TargetHUDDistance"] ~= false
        local showWeapon  = Library.Flags["TargetHUDWeapon"]   ~= false
        local showGun     = Library.Flags["TargetHUDGun"]      == true

        -- Dynamic Theme Accent colors
        local liveAccent = Library.Theme.Accent or C_ACCENT
        local liveAccent2 = Library.Theme["Dark Accent"] or C_ACCENT2

        Liner.BackgroundColor3 = liveAccent
        g1.Color = ColorSequence.new(liveAccent, liveAccent2)
        Liner2.BackgroundColor3 = liveAccent2
        g2.Color = ColorSequence.new(liveAccent, liveAccent2)

        if HPFillGrad then
            HPFillGrad.Color = ColorSequence.new(HPFill.BackgroundColor3, HPFill.BackgroundColor3:Lerp(liveAccent, 0.35))
        end

        AvatarCard.Visible  = showAvatar
        HPSection.Visible   = showHealth
        DistLabel.Visible   = showDist
        WeaponLabel.Visible = showWeapon

        -- Shrink info column if gun preview is showing
        if showGun then
            InfoCol.Size = UDim2.new(1, -138, 0, 60)
        else
            InfoCol.Size = UDim2.new(1, -82, 0, 60)
        end

        -- Name
        NameLabel.Text = target.DisplayName or target.Name or "—"
        TitleLabel.Text = "TARGET  ·  " .. (target.Name or "")

        -- Avatar (cache to avoid repeat API calls)
        if showAvatar then
            local uid = target.UserId
            if uid ~= _lastAvatarId then
                _lastAvatarId = uid
                Avatar.Image = GetPlayerAvatar(uid)
            end
        end

        -- HP
        if showHealth then
            local hp, maxHp = 100, 100
            if target.Character then
                local hum = target.Character:FindFirstChildOfClass("Humanoid")
                if hum then hp = math.floor(hum.Health); maxHp = math.floor(hum.MaxHealth) end
            end
            maxHp = math.max(maxHp, 1)
            local ratio = math.clamp(hp / maxHp, 0, 1)
            HPValueLabel.Text = hp .. " / " .. maxHp
            HPFill.Size = UDim2.new(ratio, 0, 1, 0)
            local fillColor = ratio > 0.6 and C_HP_HIGH or (ratio > 0.3 and C_HP_MED or C_HP_LOW)
            HPFill.BackgroundColor3 = fillColor
            -- also update gradient to keep it matching
            for _, g in ipairs(HPFill:GetChildren()) do
                if g:IsA("UIGradient") then
                    g.Color = ColorSequence.new(fillColor, fillColor:Lerp(C_ACCENT, 0.35))
                end
            end
            -- status dot colour mirrors HP
            StatusDot.BackgroundColor3 = fillColor
        end

        -- Distance
        -- Distance (Fixed character resolution logic for studs counting)
        if showDist then
            local dist = 0
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local tChar = target.Character or (target:IsA("Model") and target)
            local tHRP  = tChar and tChar:FindFirstChild("HumanoidRootPart")
            if myHRP and tHRP then
                dist = math.floor((myHRP.Position - tHRP.Position).Magnitude)
            end
            DistLabel.Text = dist .. " studs"
        end

        -- Weapon
        if showWeapon then
            WeaponLabel.Text = GetToolName(target)
        end

        -- Gun viewport
        if showGun then
            UpdateGunViewport(target)
            GunViewport.Visible = true
        else
            GunViewport.Visible = false
        end
    end

    Library:Connect(RunService.RenderStepped, Update)
    return Root
end

