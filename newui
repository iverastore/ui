            math.rad(data.RotSpeed.X * data.Age * 0.5 * tumbleIntensity),
            math.rad(data.RotSpeed.Y * data.Age * 0.3 * tumbleIntensity),
            math.rad(data.RotSpeed.Z * data.Age * 0.5 * tumbleIntensity)
        )
    end
end)
