                lastM, lastA, lastC, lastClr = "", "", false, nil
                for p, orig in pairs(originalPartMaterials) do
                    pcall(function()
                        if p and p.Parent then
                            p.Material = orig.Material
                            p.Color = orig.Color
                            clearCustomTextures(p)
                        end
                    end)
                end
                originalPartMaterials = setmetatable({}, { __mode = "k" })
            end
        end
    end
end)
